# deploy.ps1

Write-Host "🚀 Deployment Started..." -ForegroundColor Green

Write-Host "`nBuilding Docker image..."
docker build -t devops-cloud-project:latest .

Write-Host "`nLoading to Minikube..."
minikube image load devops-cloud-project:latest

Write-Host "`nDeploying..."
kubectl apply -f node-app.yaml
kubectl apply -f my-ingress.yaml

Write-Host "`nChecking status..."
Start-Sleep -Seconds 5
kubectl get pods

Write-Host "`nDone! Visit http://localhost:3000" -ForegroundColor Cyan
